{
  "name": "equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "bash tests/run-tests.sh",
    "db:migrate:local": "wrangler d1 migrations apply equipment-bookings --local",
    "db:migrate:remote": "wrangler d1 migrations apply equipment-bookings --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "wrangler": "^4.40.0",
    "typescript": "^5.7.2"
  }
}
