{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "equipment-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equipment-bookings",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
